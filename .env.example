# Copy to .env.local for local dev; set the same names in Vercel → Project → Settings → Environment Variables.
# Never commit real values. Everything without NEXT_PUBLIC_ stays on the server.

# Supabase (public; fall back to the project defaults in src/lib/supabase/config.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role / secret key: used only by /api/enrollments to record website payments.
SUPABASE_SERVICE_ROLE_KEY=

# Website → LMS enrollments. A long random string; set the SAME value on the website project.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENROLLMENT_WEBHOOK_SECRET=
# Where "Enroll" sends students (defaults to https://www.beyondtatva.in)
NEXT_PUBLIC_ENROLL_URL=

# Razorpay Standard Checkout on /unlock (server only; the key id is sent to the browser per order).
# Test keys start with rzp_test_. Without both, /unlock falls back to UPI or the website.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# WhatsApp login codes (Supabase Send SMS hook → /api/auth/send-otp → Meta WhatsApp Cloud API).
# Show the WhatsApp tab on /login only once all of these work: NEXT_PUBLIC_PHONE_LOGIN=1
SEND_SMS_HOOK_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=login_code
WHATSAPP_OTP_LANG=en
NEXT_PUBLIC_PHONE_LOGIN=

# Google Sheets ↔ LMS sync (scripts/sheets-sync.gs). Long random string; paste the same value in each sheet's
# "Beyond Tatva sync → Set up sync". Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHEETS_SYNC_SECRET=

# Play Store app (docs/PLAY-STORE.md). Not secret. The package name must match the one in Play Console; the
# fingerprints are the SHA-256 of the app signing key (Play Console → App integrity), comma separated.
# Without fingerprints the app still works but shows a browser bar at the top.
NEXT_PUBLIC_ANDROID_PACKAGE=in.beyondtatva.app
ANDROID_SHA256_FINGERPRINTS=
