# Copy to .env.local for local dev; set the same names in Vercel → Project → Settings → Environment Variables.
# Never commit real values. Everything without NEXT_PUBLIC_ stays on the server.

# Supabase (public; fall back to the project defaults in src/lib/supabase/config.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role / secret key: used only by the payment routes to write orders and grant access.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (Dashboard → Account & Settings → API Keys). Use rzp_test_ keys outside production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks → secret you choose for https://<lms-domain>/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=
