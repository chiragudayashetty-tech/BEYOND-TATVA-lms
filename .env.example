# Copy to .env.local for local dev; set the same names in Vercel → Project → Settings → Environment Variables.
# Never commit real values. Everything without NEXT_PUBLIC_ stays on the server.

# Supabase (public; fall back to the project defaults in src/lib/supabase/config.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role / secret key: used only by /api/enrollments to record website payments.
SUPABASE_SERVICE_ROLE_KEY=

# Website → LMS enrollments. A long random string; set the SAME value on the website project.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENROLLMENT_WEBHOOK_SECRET=
# Where "Enroll" sends students (defaults to https://www.beyondtatva.in)
NEXT_PUBLIC_ENROLL_URL=
